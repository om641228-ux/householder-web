{
  "manifest_version": 3,
  "name": "Householder — сборщик цен",
  "version": "1.20.1",
  "description": "Открывает товары из каталога Householder в фоновых вкладках и отправляет точные цены в систему.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Открыть панель сбора цен"
  },
  "externally_connectable": {
    "matches": [
      "https://householder-web-production.up.railway.app/*"
    ]
  },
  "side_panel": {
    "default_path": "popup.html"
  }
}